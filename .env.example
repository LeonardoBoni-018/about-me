# URL pública do site (usada em metadata, sitemap e OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mail do formulário de contato — configure UMA das opções (detalhes em docs/conteudo.md).
#
# Opção 1 (recomendada sem domínio próprio): SMTP, ex.: Gmail com senha de app.
# Envia o aviso para você e uma confirmação para quem escreveu.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Senha de app (myaccount.google.com/apppasswords), NÃO a senha normal da conta.
SMTP_PASS=
# Nome exibido como remetente (opcional).
CONTACT_FROM_NAME=Leonardo Boni
#
# Opção 2: Resend (https://resend.com). Sem domínio verificado, só entrega no e-mail da conta
# Resend — a confirmação para o visitante só funciona depois de verificar um domínio.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
#
# Quem recebe as mensagens. No SMTP, se vazio, vai para SMTP_USER.
CONTACT_TO_EMAIL=

# WhatsApp (celular com DDD, ex.: 18999999999). Fica fora do repositório; o botão passa por
# /api/whatsapp. Defina ANTES do build (o número exibido é pré-renderizado).
# Vazio = botão do WhatsApp oculto.
CONTACT_WHATSAPP=
