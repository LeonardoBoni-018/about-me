# URL pública do site (usada em metadata, sitemap e OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (https://resend.com) — envio do formulário de contato
RESEND_API_KEY=
# E-mail que recebe as mensagens do formulário
CONTACT_TO_EMAIL=
# Remetente verificado no Resend (ou onboarding@resend.dev para testes)
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# WhatsApp (celular com DDD, ex.: 18999999999). Fica fora do repositório; o botão passa por
# /api/whatsapp. Defina ANTES do build (o número exibido é pré-renderizado).
# Vazio = botão do WhatsApp oculto.
CONTACT_WHATSAPP=
